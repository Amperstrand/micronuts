# 64 KiB main-task stack: k256/keyset work at boot overflowed 32 KiB on
# this exact hardware (esp32-mint lesson, 2026-09-04).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
# Wallet blobs land in NVS under one atomic key; keep compaction eager.
CONFIG_NVS_COMPACT_NAMES_THRESHOLD=0
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
