# ESP32-S3 overlay, auto-picked only when building with
# `--target xtensa-esp32s3-espidf` (esp-idf-sys resolves
# `sdkconfig.defaults.<mcu>` after the base file). Target board class:
# LilyGo T-Display-S3 — ESP32-S3, 16 MB flash, USB-serial-JTAG console.
# Base sdkconfig.defaults still contributes the 64 KiB main-task stack,
# NVS compaction, log levels, and the shared partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM: DISABLED. The labgrid T-Display-S3 (tdisplay-s3-01) has absent or
# dead PSRAM — bisected 2026-09-28: SPIRAM=y aborts silently before the
# app console comes up in every mode tried (OCT@80, QIO@80, QIO@40, and
# with SPIRAM_IGNORE_NOTFOUND=y against a garbage-responding chip via
# TYPE_AUTO), while SPIRAM=n boots the wallet cleanly (M1 scaffold, NVS
# round-trip OK). The bolty-rs octal pattern works on OTHER T-Display-S3
# units (tollgate-s3-rs hardware) — this is a per-board silicon issue,
# not a lane-wide one. Nothing in the wallet needs PSRAM; if a future
# feature does, re-enable per-board with a proven-good module.
# CONFIG_SPIRAM is not set
