// Shared enums, structs, and the WalletLogic global — imported by app.slint
// and every screen (avoids circular module imports).

export enum Page {
    Home,
    Receive,
    Send,
    Scan,
    Activity,
    Settings,
    Mints,
    Backup,
}

export struct HistoryItem {
    line1: string,
    line2: string,
}

export struct MintItem {
    url: string,
    name: string,
    active: bool,
}

export global WalletLogic {
    // wallet state
    in-out property <bool> connected: false;
    in-out property <bool> busy: false;
    in-out property <bool> privacy-hide: false;
    in-out property <bool> has-active-mint: false;
    in-out property <string> balance-text: "0 sats";
    in-out property <string> mint-name: "";
    in-out property <string> mint-url: "";
    in-out property <string> status-message: "";
    // Current page name for tooling/tests ("home", "receive", …) — the
    // shell keeps it in sync; never user-facing.
    in-out property <string> page-name: "home";

    // receive: lightning invoice
    in-out property <string> invoice: "";
    in-out property <string> invoice-quote-id: "";
    // Raw NUT-04 state ("UNPAID"/"PAID") — button logic only, never shown.
    in-out property <string> invoice-state: "";
    // Phase-derived, user-facing (UX contract wording).
    in-out property <string> invoice-status-text: "";
    in-out property <string> invoice-amount-text: "";
    in-out property <int> invoice-amount: 0;
    in-out property <image> invoice-qr;

    // receive: ecash token
    in-out property <string> token-in: "";
    // Receive-ecash review state, driven from flow::ReceiveEcashPhase
    // (Rust): "input" | "inspecting" | "review" | "receiving" |
    // "received" | "failed".
    in-out property <string> receive-ecash-state: "input";
    in-out property <string> receive-review-line: "";
    in-out property <string> receive-review-fee: "";

    // send: ecash token
    in-out property <string> token-out: "";
    in-out property <image> token-qr;

    // send: lightning melt
    in-out property <string> melt-quote-info: "";
    in-out property <string> melt-preimage: "";
    // Scan routing (universal scan): pre-filled intents from a scan.
    in-out property <string> invoice-in: "";
    in-out property <string> mint-add-url: "";

    // lists + backup
    in-out property <[HistoryItem]> history;
    in-out property <[MintItem]> mints;
    in-out property <string> seed: "";

    pure callback connect();
    pure callback mint-invoice(string);
    pure callback mint-paid(string, int);
    pure callback receive-token(string);
    pure callback token-edited(string);
    pure callback send-token(string, string);
    pure callback melt-quote(string);
    pure callback melt-confirm();
    pure callback add-mint(string);
    pure callback switch-mint(int);
    pure callback toggle-privacy();
    pure callback scan-start();
    pure callback scan-stop();

    in-out property <bool> scanning: false;
    in-out property <string> scan-status: "";

    // Tab selection for the two-tab screens (0 = ecash, 1 = lightning);
    // bound at screen init — also drives the headless screenshot rig.
    in-out property <int> receive-tab: 0;
    in-out property <int> send-tab: 0;
}
