import { ScrollView } from "std-widgets.slint";
import { WalletLogic } from "logic.slint";
import { Theme } from "theme.slint";

export component HistoryScreen inherits Rectangle {
    background: transparent;
    VerticalLayout {
        padding: Theme.pad;
        spacing: 12px;
        alignment: start;
        Text { text: "Activity"; color: Theme.text; font-size: 24px; font-weight: 700; }
        ScrollView {
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                for entry in WalletLogic.history: Rectangle {
                    height: 58px;
                    border-radius: 10px;
                    background: Theme.card;
                    VerticalLayout {
                        padding: 9px;
                        spacing: 2px;
                        Text { text: entry.line1; color: Theme.text; font-size: 15px; }
                        Text { text: entry.line2; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                    }
                }
                if WalletLogic.history.length == 0 : Text {
                    text: "No activity yet.";
                    color: Theme.text-dim;
                    font-size: 14px;
                }
            }
        }
    }
}
