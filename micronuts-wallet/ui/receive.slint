import { Button, LineEdit, TextEdit } from "std-widgets.slint";
import { Page, WalletLogic } from "logic.slint";
import { BackHeader, TabBar, Theme } from "theme.slint";

export component ReceiveScreen inherits Rectangle {
    callback navigate(Page);
    in-out property <int> tab: WalletLogic.receive-tab;
    in-out property <string> amount-text: "";
    background: transparent;
    VerticalLayout {
        padding: Theme.pad;
        spacing: 12px;
        alignment: start;
        BackHeader {
            title: "Receive";
            back => { root.navigate(Page.Home); }
        }
        TabBar { current: root.tab; select(t) => { root.tab = t; } }

        if root.tab == 1 : VerticalLayout {
            spacing: 12px;
            LineEdit {
                text: root.amount-text;
                placeholder-text: "Amount (sat)";
                font-size: 18px;
                input-type: number;
                edited(text) => { root.amount-text = text; }
            }
            Button {
                text: "Create invoice";
                primary: true;
                enabled: WalletLogic.has-active-mint && !WalletLogic.busy;
                clicked => { WalletLogic.mint-invoice(root.amount-text); }
            }
            if WalletLogic.invoice != "" : VerticalLayout {
                spacing: 10px;
                Text {
                    text: WalletLogic.invoice-status-text != "" ? WalletLogic.invoice-status-text : WalletLogic.invoice-amount-text;
                    color: WalletLogic.invoice-state == "PAID" ? Theme.ok : Theme.text-dim;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 264px;
                    border-radius: 12px;
                    background: #ffffff;
                    Image {
                        source: WalletLogic.invoice-qr;
                        width: 248px;
                        height: 248px;
                    }
                }
                TextEdit {
                    text: WalletLogic.invoice;
                    read-only: true;
                    font-size: 11px;
                    height: 72px;
                }
                Button {
                    text: "Mint ecash";
                    primary: true;
                    enabled: WalletLogic.invoice-state == "PAID" && !WalletLogic.busy;
                    clicked => { WalletLogic.mint-paid(WalletLogic.invoice-quote-id, WalletLogic.invoice-amount); }
                }
            }
        }

        if root.tab == 0 : VerticalLayout {
            spacing: 12px;
            Text {
                text: "Paste ecash (cashuB…) or scan its QR.";
                color: Theme.text-dim;
                font-size: 13px;
                wrap: word-wrap;
            }
            TextEdit {
                text: WalletLogic.token-in;
                placeholder-text: "cashuB…";
                font-size: 12px;
                height: 96px;
                edited(text) => {
                    WalletLogic.token-in = text;
                    WalletLogic.token-edited(text);
                }
            }
            Button {
                text: "Scan";
                enabled: !WalletLogic.busy;
                clicked => { root.navigate(Page.Scan); }
            }

            // Review card: inspection is wallet machinery — it runs by
            // itself when input arrives; the human confirms.
            if WalletLogic.receive-ecash-state != "input" && WalletLogic.receive-ecash-state != "inspecting" : Rectangle {
                border-radius: 12px;
                background: Theme.card;
                height: 168px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: WalletLogic.receive-review-line;
                        color: WalletLogic.receive-ecash-state == "failed" ? Theme.danger : Theme.text;
                        font-size: 15px;
                        wrap: word-wrap;
                    }
                    if WalletLogic.receive-ecash-state == "review" : Text {
                        text: WalletLogic.receive-review-fee;
                        color: Theme.text-dim;
                        font-size: 13px;
                    }
                    if WalletLogic.receive-ecash-state == "review" : Button {
                        text: "Receive";
                        primary: true;
                        height: 60px;
                        enabled: !WalletLogic.busy;
                        clicked => { WalletLogic.receive-token(WalletLogic.token-in); }
                    }
                    if WalletLogic.receive-ecash-state == "receiving" : Text {
                        text: "Receiving…";
                        color: Theme.text-dim;
                        font-size: 14px;
                    }
                }
            }
            if WalletLogic.receive-ecash-state == "inspecting" : Text {
                text: "Checking this ecash…";
                color: Theme.text-dim;
                font-size: 14px;
            }
        }
    }
}
