import { Button } from "std-widgets.slint";
import { Page, WalletLogic } from "logic.slint";
import { BackHeader, Theme } from "theme.slint";

export component BackupScreen inherits Rectangle {
    callback navigate(Page);
    in-out property <bool> revealed: false;
    background: transparent;
    VerticalLayout {
        padding: Theme.pad;
        spacing: 12px;
        alignment: start;
        BackHeader {
            title: "Backup";
            back => { root.navigate(Page.Settings); }
        }
        Text {
            text: "These words recover your ecash if this device is lost or damaged. Write them down offline and keep them safe — anyone with these words can spend your ecash.";
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
        }
        Text {
            text: "Restoring re-fetches your unspent ecash from each mint you used. It cannot recover tokens you already handed over, or ecash spent elsewhere after the backup.";
            color: Theme.text-dim;
            font-size: 12px;
            wrap: word-wrap;
        }
        Rectangle {
            min-height: 72px;
            border-radius: 12px;
            background: Theme.card;
            VerticalLayout {
                padding: 12px;
                Text {
                    text: root.revealed ? WalletLogic.seed : "•••••••••••••••••••••••••••••••";
                    color: root.revealed ? Theme.warn : Theme.text-dim;
                    font-size: 14px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
        Button {
            text: root.revealed ? "Hide seed" : "Reveal seed";
            clicked => { root.revealed = !root.revealed; }
        }
        Text {
            text: "Anyone holding this seed can spend your ecash. Never share it.";
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }
        Rectangle { height: 8px; }
        Button {
            text: "Done";
            clicked => { root.navigate(Page.Settings); }
        }
    }
}
